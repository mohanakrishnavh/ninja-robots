# Copy to .env (and never commit the real file) or export these in your shell.
# Both are optional -- unset, each client falls back to public/anonymous access.

# LinkedIn: your account's `li_at` session cookie value (browser dev tools ->
# Application -> Cookies -> linkedin.com -> li_at). Enables authenticated
# search via LinkedIn's internal Voyager API. This is automated use of a
# personal account against LinkedIn's Terms of Service -- use an account
# you're comfortable putting at risk of rate-limiting/restriction.
LINKEDIN_LI_AT_COOKIE=

# Indeed: your Publisher API publisher ID (Indeed Publisher Program).
# Enables structured JSON results via Indeed's key-based API instead of
# scraping HTML. Indeed has largely closed this program to new applicants.
INDEED_PUBLISHER_ID=
